<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <joint name="LF_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max"> 10</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
    <!--joint info for rest of wheels-->
        <joint name="LB_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max"> 10</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        <joint name="RF_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max"> 10</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        <joint name="RB_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max"> 10</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
    <!--code contd-->
    </ros2_control>

<!--when not using gazebo, need to run:-->
<!--ros2 run controller_manager ros2_control_node-->
    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find autonomous_rover)/config/my_controllers.yaml</parameters>
        </plugin>
        
    </gazebo>
    
</robot>
