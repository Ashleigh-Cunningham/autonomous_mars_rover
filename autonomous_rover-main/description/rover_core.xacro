<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <xacro:include filename="inertial_macros.xacro"/>

    <material name="white">
        <color rgba ="1 1 1 1"/>
    </material>

    <material name="blue">
        <color rgba ="0 0 1 1"/>
    </material>

    <link name="base_link">
    </link>

    <!-- <joint name= "base_footprint_joint" type="fixed"> 
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    
    </joint>

    <link name="base_footprint">
    </link> -->

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0.075"/> 
    </joint>

    <link name="chassis">
        <visual>
            <geometry>
                <box size="0.25 0.20 0.06"/>
            </geometry>
            <material name="white"/>
            <origin xyz="0 0 0"/> 
        </visual>
        <visual>
            <geometry> 
                <cylinder radius="0.025" length="0.02"/>
            </geometry>
            <material name="white"/>
            <origin xyz="0.06 0.05 0.04"/> 
        </visual>
        <collision>
            <geometry>
                <box size="0.25 0.20 0.06"/>
            </geometry>
            
            <origin xyz="0 0 0"/>
        </collision>
        <collision>
            <geometry> 
                <cylinder radius="0.025" length="0.02"/>
            </geometry>
            <origin xyz="0.06 0.05 0.04"/> 
        </collision>
        <xacro:inertial_box mass="0.5" x="0" y="0" z="0">
            <origin xyz = "0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>
    <!--0.0508 was the z value before for visual & collision (for ref)-->
    <gazebo reference="chassis">
        <material> Gazebo/White</material>
    </gazebo>


    <!-- wheel links-->
    <!-- LF-->
    <joint name="LF_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="LF_wheel"/>
        <origin xyz="0.1 0.12 -0.025" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="LF_wheel">
        <visual>
            <geometry> 
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry> 
                <sphere radius="0.05"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz = "0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>

    </link>
    <gazebo reference="LF_wheel">
        <material> Gazebo/Blue</material>
    </gazebo>
    <!-- LB-->
    <joint name="LB_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="LB_wheel"/>
        <origin xyz="-0.1 0.12 -0.025" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    
    <link name="LB_wheel">
        <visual>
            <geometry> 
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry> 
                <sphere radius="0.05"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz = "0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="LB_wheel">
        <material> Gazebo/Blue</material>
    </gazebo>

    <!-- RF-->
    <joint name="RF_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="RF_wheel"/>
        <origin xyz="0.1 -0.12 -0.025" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="RF_wheel">
        <visual>
            <geometry> 
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry> 
                <sphere radius="0.05"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz = "0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="RF_wheel">
        <material> Gazebo/Blue</material>
    </gazebo>

    <!-- RB-->
    <joint name="RB_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="RB_wheel"/>
        <origin xyz="-0.1 -0.12 -0.025" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="RB_wheel">
        <visual>
            <geometry> 
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry> 
                <sphere radius="0.05"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz = "0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="RB_wheel">
        <material> Gazebo/Blue</material>
    </gazebo>

</robot>